{
  "name": "@nexus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --hot src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../packages/config/oxlint.json src"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.0",
    "@ioredis/commands": "^2.0.0",
    "@nexus/db": "workspace:*",
    "@nexus/types": "workspace:*",
    "@nexus/zod-schemas": "workspace:*",
    "better-auth": "^1.3.0",
    "bullmq": "^6.2.0",
    "hono": "4.13.2",
    "ioredis": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.9.3"
  }
}
