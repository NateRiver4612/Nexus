{
  "name": "@nexus/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "bun --env-file=.env --hot src/index.ts",
    "start": "bun --env-file=.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../packages/config/oxlint.json src",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "bun --env-file=.env src/seed.ts",
    "reset": "bash ../../scripts/reset-db.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@better-auth/infra": "^0.4.5",
    "@hono/zod-openapi": "^1.6.0",
    "@ioredis/commands": "^2.0.0",
    "@mozilla/readability": "^0.5.0",
    "@nexus/db": "workspace:*",
    "@nexus/types": "workspace:*",
    "@nexus/zod-schemas": "workspace:*",
    "@types/node": "^26.4.1",
    "better-auth": "^1.3.0",
    "bullmq": "^6.2.0",
    "drizzle-orm": "^0.44.0",
    "hono": "4.13.2",
    "ioredis": "^6.0.0",
    "jsdom": "^26.0.0",
    "mammoth": "^1.8.0",
    "openai": "^5.0.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^6.0.0",
    "xlsx": "^0.18.5",
    "youtube-transcript": "^1.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/jsdom": "^30.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.3"
  }
}
