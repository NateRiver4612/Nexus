{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@nexus/web",
    "dev:api": "turbo run dev --filter=@nexus/api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "bun run --filter=@nexus/db generate",
    "db:migrate": "bun run --filter=@nexus/db migrate",
    "db:seed": "bun run --filter=@nexus/db seed"
  },
  "devDependencies": {
    "oxlint": "^0.17.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
